PORT=3000
DATABASE_URL="mysql://reallymeet:reallymeet_dev@localhost:3306/reallymeet"

# Hostinger (produção): RUN_MIGRATIONS_ON_BOOT=1

# E-mail (OTP cadastro / esqueci senha).
# Sem MAIL_HOST: código só no log do backend. MAIL_DEV_RETURN_CODE=1 também devolve na resposta (só em dev!).
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Really Meet <noreply@seu-dominio.com>"
MAIL_DEV_RETURN_CODE=1
# Hostinger SMTP (exemplo): MAIL_HOST=smtp.hostinger.com MAIL_PORT=465 MAIL_SECURE=true
# MAIL_USER=contato@seu-dominio.com MAIL_PASS=senha-da-caixa-de-email
OTP_EXPIRES_MINUTES=15
OTP_MIN_RESEND_SECONDS=60

# Updater do desktop: repo das GitHub Releases desktop-vX.Y.Z (GITHUB_TOKEN opcional, so para limite de requisicoes)
DESKTOP_RELEASES_REPO=PedroDmMaia/ReallyMeet-back
GITHUB_TOKEN=

JWT_ACCESS_SECRET=change_me_access_secret_dev
JWT_REFRESH_SECRET=change_me_refresh_secret_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=sua-api-key
LIVEKIT_API_SECRET=seu-api-secret
LIVEKIT_WEBHOOK_SECRET=

# Dev desktop (JCEF) usa portas dinamicas em 127.0.0.1 — o backend tambem aceita esse padrao no codigo.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
